{
  "name": "toppy/symfony-async-twig-bundle",
  "description": "Symfony integration bundle for async Twig rendering stack",
  "type": "symfony-bundle",
  "license": "proprietary",
  "autoload": {
    "psr-4": {
      "Toppy\\SymfonyAsyncTwigBundle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Toppy\\SymfonyAsyncTwigBundle\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": ">=8.4",
    "toppy/async-view-model": "^0.3",
    "toppy/twig-view-model": "^0.3",
    "symfony/framework-bundle": "^7.0 || ^8.0",
    "symfony/twig-bundle": "^7.0 || ^8.0",
    "symfony/http-kernel": "^7.0 || ^8.0",
    "symfony/http-foundation": "^7.0 || ^8.0",
    "symfony/dependency-injection": "^7.0 || ^8.0",
    "symfony/config": "^7.0 || ^8.0",
    "symfony/routing": "^7.0 || ^8.0",
    "symfony/event-dispatcher": "^7.0 || ^8.0",
    "symfony/lock": "^7.0 || ^8.0",
    "symfony/asset": "^7.0 || ^8.0",
    "psr/log": "^1.0 || ^2.0 || ^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.5",
    "symfony/asset-mapper": "^7.0 || ^8.0",
    "symfony/web-profiler-bundle": "^7.0 || ^8.0"
  },
  "suggest": {
    "toppy/twig-streaming": "Required for streaming templates, deferred slots, and early hints",
    "toppy/twig-prerender": "Required for {% include ... prerender(false) %} and {% include ... defer(true) %} modifiers",
    "open-telemetry/api": "For OpenTelemetry tracing integration",
    "pentatrion/vite-bundle": "For Vite Early Hints provider"
  },
  "extra": {
    "symfony": {
      "bundles": {
        "Toppy\\SymfonyAsyncTwigBundle\\ToppySymfonyAsyncTwigBundle": [
          "all"
        ]
      }
    }
  }
}
