{
    "name": "toppy/symfony-async-twig-bundle",
    "description": "Symfony integration bundle for async Twig rendering stack",
    "type": "symfony-bundle",
    "license": "proprietary",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {"type": "path", "url": "../async-view-model", "options": {"symlink": true}},
        {"type": "path", "url": "../twig-view-model", "options": {"symlink": true}},
        {"type": "path", "url": "../twig-streaming", "options": {"symlink": true}},
        {"type": "path", "url": "../twig-prerender", "options": {"symlink": true}}
    ],
    "autoload": {
        "psr-4": {
            "Toppy\\SymfonyAsyncTwigBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Toppy\\SymfonyAsyncTwigBundle\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.4",
        "toppy/async-view-model": "*@dev",
        "toppy/twig-view-model": "*@dev",
        "toppy/twig-streaming": "*@dev",
        "toppy/twig-prerender": "*@dev",
        "symfony/framework-bundle": "^8.0",
        "symfony/twig-bundle": "^8.0",
        "symfony/http-kernel": "^8.0",
        "symfony/dependency-injection": "^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "symfony/asset-mapper": "^8.0",
        "symfony/web-profiler-bundle": "^8.0"
    },
    "suggest": {
        "open-telemetry/api": "For OpenTelemetry tracing integration",
        "pentatrion/vite-bundle": "For Vite Early Hints provider"
    },
    "extra": {
        "symfony": {
            "bundles": {
                "Toppy\\SymfonyAsyncTwigBundle\\ToppySymfonyAsyncTwigBundle": ["all"]
            }
        }
    }
}
